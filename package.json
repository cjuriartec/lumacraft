{
  "name": "lumacraft",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "npm run test:unit && npm run test:component && npm run test:integration",
    "test:unit": "vitest run --project unit",
    "test:component": "vitest run --project component",
    "test:integration": "node scripts/with-local-supabase-env.mjs vitest run --project integration",
    "test:smoke": "node scripts/with-local-supabase-env.mjs playwright test --project smoke",
    "test:e2e": "node scripts/with-local-supabase-env.mjs playwright test --project full",
    "test:coverage": "node scripts/with-local-supabase-env.mjs vitest run --coverage --project unit --project component --project integration",
    "test:coverage:strict": "node scripts/with-local-supabase-env.mjs env STRICT_COVERAGE=true vitest run --coverage --project unit --project component --project integration",
    "test:all": "npm test && npm run test:smoke && npm run test:e2e",
    "supabase:stop": "npx supabase stop",
    "supabase:clean": "npx supabase stop --no-backup && docker rmi $(docker images 'supabase/*' -q) 2>/dev/null; docker rmi $(docker images 'public.ecr.aws/supabase/*' -q) 2>/dev/null; docker rmi $(docker images 'postgrest/postgrest' -q) 2>/dev/null; echo '✅ Supabase eliminado completamente (contenedores + volúmenes + imágenes ECR).'",
    "supabase:local": "node scripts/setup-local.mjs",
    "supabase:local:reset": "npx supabase db reset",
    "supabase:cloud:reset": "npx supabase db reset --linked",
    "supabase:cloud:push": "npx supabase db push --linked"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@supabase/ssr": "^0.9.0",
    "@supabase/supabase-js": "^2.100.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.7.0",
    "next": "16.2.1",
    "next-themes": "^0.4.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.72.0",
    "tailwind-merge": "^3.5.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.2",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.1",
    "jsdom": "^29.0.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.2"
  }
}