# 🌐 Supabase Configuration (Public)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_key_here

# 🔐 Supabase Configuration (Private / Secret Key)
# IMPORTANT: This key bypasses RLS. Use ONLY for local development, tests, or specific admin tasks.
SUPABASE_SECRET_KEY=sb_secret_key_here

# 🛡️ Security / Encryption
# Master Key for encrypting AI provider secrets (Gemini, OpenAI, etc.)
AI_SETTINGS_MASTER_KEY=define-una-clave-maestra-segura-para-cifrar-secrets-ai

# 🧪 Testing (Optional)
# DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres